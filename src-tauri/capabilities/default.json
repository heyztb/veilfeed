{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core reader window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*", "app": "Tor Browser" },
        { "url": "https://*", "app": "Tor Browser" }
      ]
    }
  ]
}
